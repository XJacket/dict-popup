<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  dict-popup application manifest - UIAccess variant.

  Embedded as RT_MANIFEST (resource id 1, type 24) by assets/version.rc.
  windres embeds this file verbatim, so the text below is what Windows reads.

  uiAccess="true" is opt-in: a binary that requests UIAccess MUST be
  Authenticode-signed by a certificate trusted on the machine and installed
  under %ProgramFiles%, otherwise Windows refuses to start it. build.bat
  embeds this variant only when /uiaccess (or DICT_POPUP_UIACCESS=1) is given.
  The default build embeds dict-popup-no-uiaccess.manifest instead.

  No assemblyIdentity is declared on purpose: a version number here would rot
  with every release and nothing depends on it.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <!-- asInvoker: never ask for elevation; UIAccess is the sanctioned way to
       cross integrity levels for the synthetic Ctrl+C capture path. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="true" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Per-Monitor-V2 DPI awareness. The legacy dpiAware element covers
       Windows versions that do not understand the 2016 settings namespace. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <!-- Windows 10/11. PerMonitorV2 is only honoured when a supported OS is
       declared; the GUID is Windows 10's, and Windows 11 matches it too. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>

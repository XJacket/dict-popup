// dict-popup Windows resources: application icon + VERSIONINFO.
// Compile with:
//   windres -I assets --codepage=65001 -O coff -o assets\dict-popup.res assets\version.rc
// (UTF-8 source; --codepage=65001 keeps the Chinese FileDescription intact.)

#pragma code_page(65001)

#include <windows.h>

// Application icon. Also used for the tray icon at runtime.
1 ICON "dict-popup.ico"

// Application manifest: RT_MANIFEST is resource type 24, and Windows only
// reads id 1. windres embeds the chosen file verbatim, so the manifest's XML
// reaches the binary unchanged.
//
// The default build embeds uiAccess="false". build.bat /uiaccess (or
// DICT_POPUP_UIACCESS=1) passes -D DICT_POPUP_UIACCESS to windres, which
// selects the uiAccess="true" manifest for signed builds only: an unsigned
// binary that requests UIAccess does not start.
#ifdef DICT_POPUP_UIACCESS
1 24 "dict-popup.manifest"
#else
1 24 "dict-popup-no-uiaccess.manifest"
#endif

1 VERSIONINFO
  FILEVERSION     0,2,1,0
  PRODUCTVERSION  0,2,1,0
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "XuJake"
      VALUE "FileDescription",  "离线划词词典"
      VALUE "FileVersion",      "0.2.1.0"
      VALUE "InternalName",     "dict-popup"
      VALUE "LegalCopyright",   "© 2026 XuJake"
      VALUE "OriginalFilename", "dict-popup.exe"
      VALUE "ProductName",      "dict-popup"
      VALUE "ProductVersion",   "0.2.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

// dict-popup Windows resources: application icon + VERSIONINFO.
// Compile with:
//   windres -I assets --codepage=65001 -O coff -o assets\dict-popup.res assets\version.rc
// (UTF-8 source; --codepage=65001 keeps the Chinese FileDescription intact.)

#pragma code_page(65001)

#include <windows.h>

// Application icon. Also used for the tray icon at runtime.
1 ICON "dict-popup.ico"

1 VERSIONINFO
  FILEVERSION     0,1,0,0
  PRODUCTVERSION  0,1,0,0
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "XuJake"
      VALUE "FileDescription",  "离线划词词典"
      VALUE "FileVersion",      "0.1.0.0"
      VALUE "InternalName",     "dict-popup"
      VALUE "LegalCopyright",   "© 2026 XuJake"
      VALUE "OriginalFilename", "dict-popup.exe"
      VALUE "ProductName",      "dict-popup"
      VALUE "ProductVersion",   "0.1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

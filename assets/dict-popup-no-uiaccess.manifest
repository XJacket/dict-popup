<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  dict-popup application manifest - default (no UIAccess) variant.

  Identical to dict-popup.manifest except for uiAccess="false": this is what
  plain `build.bat` embeds, so the shipped default keeps today's behaviour and
  an unsigned binary still starts.

  No assemblyIdentity is declared on purpose: a version number here would rot
  with every release and nothing depends on it.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <!-- asInvoker: never ask for elevation. Without UIAccess, Windows blocks
       synthetic Ctrl+C input to higher-integrity windows (UIPI); the capture
       pipeline then simply falls back to its other strategies. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Per-Monitor-V2 DPI awareness. The legacy dpiAware element covers
       Windows versions that do not understand the 2016 settings namespace. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <!-- Windows 10/11. PerMonitorV2 is only honoured when a supported OS is
       declared; the GUID is Windows 10's, and Windows 11 matches it too. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
